# ─── Supabase Yapılandırması (ZORUNLU) ──────────────────────────────────────
# https://supabase.com → Projenizi açın → Settings → API
VITE_SUPABASE_URL=https://XXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Google Gemini AI (Opsiyonel — AI Asistan için) ─────────────────────────
# https://aistudio.google.com/app/apikey adresinden alın
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ─── Uygulama URL (Vercel deploy sonrası güncelle) ───────────────────────────
VITE_APP_URL=https://volkann.vercel.app

# ─── Kurulum Adımları ────────────────────────────────────────────────────────
# 1. Bu dosyayı `.env.local` olarak kopyalayın: cp .env.example .env.local
# 2. Yukarıdaki değerleri gerçek bilgilerle doldurun
# 3. Vercel Dashboard → Settings → Environment Variables kısmına da ekleyin
# 4. `npm run dev` ile uygulamayı başlatın
